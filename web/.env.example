# Copy to .env.local (not committed)

# Browser → API (same origin when API_UPSTREAM is set — see below)
# Local + proxy to Render: http://localhost:3001/api/v1
# Local + local Nest only:     http://localhost:3000/api/v1
# Vercel production:           /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Nest origin for Next rewrites (no /api/v1 suffix). Omit for direct local API only.
# API_UPSTREAM=https://luxian.onrender.com

# Server-side calls (UploadThing auth, cache revalidate) — direct to Nest, not via proxy
# API_INTERNAL_URL=https://luxian.onrender.com/api/v1

# UploadThing — paste API token from https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# Optional: only if using Cloudflare R2 instead of UploadThing (see api/CLOUDFLARE_R2_SETUP.md)
# NEXT_PUBLIC_IMAGE_HOST=pub-xxxxxxxx.r2.dev
