PORT=3000
CORS_ORIGIN=http://localhost:3001
# Production: set parent domain when web + API share a site (e.g. .luxian.com)
# COOKIE_DOMAIN=.luxian.com
# Use Neon pooler URL in dev/prod, e.g. …-pooler….neon.tech/…?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional tuning (Neon cold start may need 20–30s on first connect)
# DB_CONNECTION_TIMEOUT_MS=20000
# DB_QUERY_TIMEOUT_MS=20000
# DB_POOL_MAX=10
# DATABASE_SSL=false
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m

# Cloudflare R2 (image uploads) — see api/CLOUDFLARE_R2_SETUP.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=luxian-media
R2_PUBLIC_URL=

# After migrate: npm run db:seed
# Demo logins: admin@demo.com / user@demo.com — password: Secret1!
